# Supabase - URL pública e chave service role (server-side)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Chave publica (anon) - usada pelo cliente browser do Supabase Auth. Nao da
# acesso a dados protegidos por RLS; e segura para expor no frontend.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Projetos Supabase novos podem fornecer uma publishable key em vez da anon key.
# Use esta variavel quando a chave comecar com sb_publishable_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Rollback operacional dos Indicadores v2. Use false temporariamente durante
# o rollout se a migration/backfill ainda não estiverem prontos.
INDICADORES_CONFIABILIDADE_V2=true

# Senha do banco Postgres do projeto Supabase (usada só por scripts/migrations,
# não é exigida em runtime se já tem service role key)
SUPABASE_DB_PASSWORD=

# OpenAI - chave e modelo padrão do pipeline de extração
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5

# eGestor - opcional; a configuracao principal pode ser feita pela tela Configuracoes.
# O token nunca deve ser exposto ao frontend.
EGESTOR_MAX_RETRIES=2

# Porta exposta pelo container (EasyPanel injeta automaticamente)
# PORT=3000
